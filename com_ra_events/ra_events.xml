<!-- 16/09/23 CB Created from mailman
    15/06/25 CB added api (version 2.1.0)
    29/06/25 CB new version of src (API interface)
    01/09/25 CB changed folder name from src to api
    02/10/25 CB version 2.3.0 - bespoike fields on events/bookings
    27/02/26 CB version 2.4.12 - created with service provider
    21/08/26 RH version 2.6.0 - track paid status on bookings
    21/08/26 RH version 2.7.0 - restrict paid status to authorised users, per-event opt-in
    21/08/26 RH version 2.7.1 - fix permission label
    21/08/26 RH version 2.7.2 - show requires_payment field on event edit form
    22/08/26 RH version 2.8.0 - grouped booking status boxes, event waiting list
    22/08/26 RH version 2.8.1 - fix mailshot queue/cancel sending button, updateOutstanding bug
    22/08/26 RH version 2.8.2 - auto-enable plg_ra_eventscli console plugin on install
    22/08/26 RH version 2.8.3 - show Max Places box on bookings page
-->
<extension type="component" version="4.0" method="upgrade">
    <name>RA Events</name>
    <element>com_ra_events</element>
    <creationDate>03/Aug 2026</creationDate>
    <copyright>Copyright (C) 2022. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <author>Charlie Bigley</author>
    <authorEmail>webmaster@bigley.me.uk</authorEmail>
    <authorUrl>https://docs.stokeandnewcastleramblers.org.uk</authorUrl>
    <version>2.8.3</version>
    <description>Support for Events and Bookings</description>
    <namespace path="src">Ramblers\Component\Ra_events</namespace>   
    <scriptfile>script.php</scriptfile>	
    <api>
        <files folder="api">
            <folder>services</folder>
            <folder>src</folder>
        </files>
    </api>
    <files folder="site">
        <folder>forms</folder>
        <folder>src</folder>
        <folder>tmpl</folder> 
    </files>
    <media folder="media" destination="com_ra_events">
        <filename>joomla.asset.json</filename>
    </media>
	
    <administration>
        <menu link="option=com_ra_events&amp;view=events">RA Events</menu>
        <files folder="administrator">
            <folder>forms</folder>
            <folder>presets</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>   
            <filename>access.xml</filename>
            <filename>config.xml</filename>            
        </files>
    </administration>
	
    <!-- Runs on install -->
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <!-- Runs on uninstall -->
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <!-- Runs on update -->
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql/</schemapath>
        </schemas>
    </update>
</extension>
